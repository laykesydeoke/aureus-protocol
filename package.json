{
  "name": "sbtc-yield-aggregator-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "test:analytics": "vitest run tests/yield_analytics_test.ts tests/adapter_analytics_test.ts tests/deposit_analytics_test.ts",
    "test:distribution": "vitest run tests/yield_distribution_test.ts tests/withdraw_analytics_test.ts tests/multi_user_analytics_test.ts",
    "test:ratios": "vitest run tests/yield_ratio_test.ts tests/protocol_rate_test.ts",
    "test:security": "vitest run tests/emergency_pause_test.ts",
    "test:rewards": "vitest run tests/deposit_count_test.ts tests/user_tier_test.ts tests/tier_bonus_test.ts",
    "test:loyalty": "vitest run tests/loyalty_rewards_test.ts tests/first_deposit_test.ts tests/tier_analytics_test.ts",
    "test:reward-edge": "vitest run tests/reward_edge_test.ts tests/reward_invariant_test.ts",
    "test:governance": "vitest run tests/governance_params_test.ts tests/min_deposit_test.ts tests/governance_access_test.ts",
    "test:governance-edge": "vitest run tests/governance_edge_test.ts tests/governance_invariant_test.ts",
    "test:governance-admin": "vitest run tests/admin_config_test.ts tests/governance_audit_test.ts tests/governance_flow_test.ts",
    "test:optimization": "vitest run tests/optimization_params_test.ts tests/rebalance_threshold_test.ts tests/optimization_toggle_test.ts",
    "test:rebalance": "vitest run tests/auto_rebalance_test.ts tests/yield_rebalance_full_test.ts tests/yield_routing_test.ts",
    "test:opt-edge": "vitest run tests/optimization_edge_test.ts tests/optimization_invariant_test.ts tests/optimization_auth_test.ts",
    "test:reporting": "vitest run tests/portfolio_report_test.ts tests/snapshot_test.ts tests/snapshot_retrieval_test.ts",
    "test:snapshots": "vitest run tests/multi_snapshot_test.ts tests/snapshot_integrity_test.ts tests/snapshot_data_test.ts",
    "test:compliance": "vitest run tests/audit_trail_test.ts tests/report_export_test.ts tests/institutional_summary_test.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hirosystems/clarinet-sdk": "^3.7.0",
    "@stacks/transactions": "^7.2.0",
    "@types/node": "^24.5.2",
    "chokidar-cli": "^3.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-environment-clarinet": "^2.3.0"
  },
  "devDependencies": {
    "@hirosystems/clarinet-sdk-wasm": "^3.7.0",
    "vite": "^7.1.7"
  }
}