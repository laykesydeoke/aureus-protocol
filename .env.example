# Aureus Protocol environment variables
# Copy to .env and fill in values

# Stacks network
STACKS_NETWORK=testnet
STACKS_API_URL=https://stacks-node-api.testnet.stacks.co

# Contract deployer
DEPLOYER_ADDRESS=

# Contract names
YIELD_AGGREGATOR_CONTRACT=yield-aggregator
PROTOCOL_ADAPTER_CONTRACT=protocol-adapter
MOCK_SBTC_CONTRACT=mock-sbtc

# Analytics
ANALYTICS_REFRESH_MS=30000
SHOW_YIELD_ANALYTICS=true
SHOW_ADAPTER_ANALYTICS=true

# Yield settings
MIN_DEPOSIT_SBTC=1000
MAX_DEPOSIT_SBTC=100000000000
YIELD_PRECISION=10000

# Protocol rates (basis points)
DEFAULT_ZEST_RATE=850
DEFAULT_VELAR_RATE=700
DEFAULT_ALEX_RATE=650
DEFAULT_STACKING_RATE=500

# Security
EMERGENCY_PAUSE_ENABLED=true
ADMIN_ONLY_REBALANCE=true

# Deposit Rewards
TIER_SYSTEM_ENABLED=true
TIER_1_MIN_DEPOSITS=1
TIER_2_MIN_DEPOSITS=5
TIER_3_MIN_DEPOSITS=10
TIER_2_BONUS_BPS=50
TIER_3_BONUS_BPS=100
SHOW_USER_TIER=true
TIER_DISPLAY_NAMES=Bronze,Silver,Gold

# Protocol Governance
GOVERNANCE_ENABLED=true
MIN_DEPOSIT_GOVERNANCE=1000
MAX_WITHDRAWAL_PCT=100
GOVERNANCE_LOG_ACTIONS=true
SHOW_GOVERNANCE_PARAMS=true
GOVERNANCE_ADMIN_ONLY=true

# Yield Optimization
OPTIMIZATION_ENABLED=true
REBALANCE_THRESHOLD_BPS=50
TARGET_PROTOCOL=1
AUTO_REBALANCE_INTERVAL=100
SHOW_OPTIMIZATION_PARAMS=true

# Institutional Reporting
REPORTING_ENABLED=true
AUTO_SNAPSHOT_INTERVAL=100
MAX_SNAPSHOTS=1000
COMPLIANCE_MODE=true
SHOW_PORTFOLIO_REPORT=true
